# Python caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (.environment is the one .01_install.py creates)
.environment/
.venv/
venv/
env/
ENV/

# Environment / secrets
# .env is committed on purpose: it is the project's single settings file.
# Other local variants (.env.local, .env.prod, …) stay out of git.
.env.*

# Django runtime
*.sqlite3
/media/
/staticfiles/

# The archive park: real people's purged accounts. It is a backup location on
# the server, never source. (apps.accounts.archiving)
/backups/archived_accounts/

# Database dumps. Full copies of live data — names, e-mail addresses, dates of
# birth, payment records. Never source, never in a repository.
/backups/db/
*.dump
*.sql.gz

# Local logs / coverage
*.log
.coverage
htmlcov/

# macOS Finder junk
.DS_Store
**/.DS_Store
.environment/

# macOS / editors
.DS_Store
.vscode/
.idea/
user_activity.log

# Client copy of the README (kept on this computer only)
/United Church School - Learning Platform.pdf

# Setup reports written by .01_install.py … .04_demo_seed.py
/reports/
