#!/usr/bin/env bash
# =============================================================================
# .setup — set up the United Church School learning platform on a new computer
# =============================================================================
#
# Run it from the folder that contains manage.py:
#
#     bash .setup                 # full setup (asks before anything destructive)
#     bash .setup --demo          # …and load the demo learners, teachers and parents
#     bash .setup --reset         # DESTRUCTIVE: wipe the database and rebuild it
#     bash .setup --check         # only verify an existing setup, change nothing
#     bash .setup --yes           # answer "yes" to every question
#
# What it does, in order:
#
#   1. Checks for .env (copies .env.example if it is missing, then stops so you
#      can fill it in). All database settings are read from .env.
#   2. Finds Python 3.12+ (installs it with Homebrew / apt if missing — on a new
#      Mac it offers to install Homebrew itself first).
#   3. Creates the virtual environment  .environment  and activates it.
#   4. Installs requirements.txt inside the environment.
#   5. Finds PostgreSQL (or installs it — Homebrew on macOS, apt on
#      Debian/Ubuntu — when none is installed and the .env database is on this
#      computer) and makes sure it is running.
#   6. Creates the database user and the database named in .env
#      (POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_HOST /
#      POSTGRES_PORT, or DATABASE_URL) — with exactly those credentials.
#   7. Checks Redis when .env turns it on (USE_REDIS=true).
#   8. Runs Django's checks and migrations, installs the school structure
#      (Grade 1 – 12, CAPS subjects, monthly fees per grade, a class per grade,
#      the GDE school calendars for 2026 and 2027), the school shop and three
#      days of demo lessons per subject, collects static files, and offers to
#      create the five base accounts (admin, staff, educator, student, parent).
#   9. Verifies everything: the environment, packages, the database
#      connection, migrations, the school data (grades, subjects, calendars,
#      lessons, class teachers), the time zone, the SA-SAMS EMIS number,
#      Redis, and the web app itself.
#
# The full install order (with what to run after this) is at the top of
# .install_requirements.py.
#
# Safe to run again: every step checks first and only does what is missing.
# Supported: macOS (Homebrew, the EDB PostgreSQL installer in /Library/PostgreSQL,
# or Postgres.app) and Debian/Ubuntu Linux. On Windows use WSL.
#
# On macOS with the EDB installer the script needs the password of the
# PostgreSQL administrator 'postgres' (chosen when PostgreSQL was installed)
# only if the .env user does not exist yet; it asks for it, or reads it from
# the POSTGRES_ADMIN_PASSWORD environment variable. It is never written to disk.
# =============================================================================
set -uo pipefail

ENV_DIR=".environment"
PY_MIN_MAJOR=3
PY_MIN_MINOR=12
PG_VERSION="16"

ASSUME_YES=0; DEMO=0; RESET=0; CHECK_ONLY=0
for arg in "$@"; do
  case "$arg" in
    -y|--yes) ASSUME_YES=1 ;;
    --demo) DEMO=1 ;;
    --reset) RESET=1 ;;
    --check) CHECK_ONLY=1 ;;
    -h|--help) sed -n '2,44p' "$0"; exit 0 ;;
    *) echo "Unknown option: $arg (see bash .setup --help)"; exit 2 ;;
  esac
done

cd "$(dirname "$0")" || exit 1
ROOT="$(pwd)"

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------
if [ -t 1 ]; then B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; N=$'\033[0m'
else B=""; G=""; Y=""; R=""; N=""; fi
FAILURES=0; WARNINGS=0
step()  { echo; echo "${B}==> $*${N}"; }
ok()    { echo "  ${G}[ ok ]${N} $*"; }
warn()  { echo "  ${Y}[warn]${N} $*"; WARNINGS=$((WARNINGS + 1)); }
fail()  { echo "  ${R}[FAIL]${N} $*"; FAILURES=$((FAILURES + 1)); }
die()   { echo; echo "${R}Setup stopped:${N} $*"; exit 1; }
have()  { command -v "$1" >/dev/null 2>&1; }
confirm() {
  [ "$ASSUME_YES" -eq 1 ] && return 0
  local answer; read -r -p "  $1 [y/N] " answer
  [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]
}

OS="$(uname -s)"
case "$OS" in
  Darwin) PLATFORM="macos" ;;
  Linux)  PLATFORM="linux" ;;
  *) die "unsupported system '$OS'. Use macOS, Debian/Ubuntu Linux, or WSL on Windows." ;;
esac
SUDO=""; [ "$PLATFORM" = "linux" ] && [ "$(id -u)" -ne 0 ] && SUDO="sudo"

# Homebrew on a brand-new Mac: it may be installed but not yet on PATH (the
# installer only prints the shellenv line), or not installed at all.
load_brew() {
  local b
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ -x "$b" ] && eval "$("$b" shellenv)" && return 0
  done
  return 1
}
ensure_brew() {
  [ "$PLATFORM" = "macos" ] || return 0
  have brew || load_brew && return 0
  warn "Homebrew (the macOS package manager) is not installed — it is needed for Python and PostgreSQL."
  confirm "Install Homebrew now? (it asks for your Mac password)" || die "Install Homebrew from https://brew.sh, then run bash .setup again."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    || die "the Homebrew installer failed — see https://brew.sh"
  load_brew || die "Homebrew installed but brew was not found — open a new terminal and re-run."
  ok "Homebrew installed"
}
[ "$PLATFORM" = "macos" ] && { have brew || load_brew || true; }

echo "${B}United Church School — learning platform setup${N}"
echo "  folder   : $ROOT"
echo "  system   : $PLATFORM"

[ -f manage.py ] || die "manage.py not found — run this from the project folder."

# ---------------------------------------------------------------------------
# 1. .env
# ---------------------------------------------------------------------------
step "1/9  Configuration (.env)"
if [ ! -f .env ]; then
  if [ -f .env.example ]; then
    cp .env.example .env
    warn "No .env found — created one from .env.example."
    die "Fill in .env (SECRET_KEY, POSTGRES_* or DATABASE_URL, e-mail …) and run bash .setup again."
  fi
  die "No .env and no .env.example to start from."
fi
ok ".env found"

# Read a KEY=value from .env (first match, quotes stripped, comments ignored).
env_get() {
  local key="$1" line value
  line="$(grep -E "^[[:space:]]*${key}[[:space:]]*=" .env | tail -n 1)" || true
  [ -z "$line" ] && return 0
  value="${line#*=}"
  value="${value%%[[:space:]]#*}"                       # trailing " # comment"
  value="$(printf '%s' "$value" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  value="${value%\"}"; value="${value#\"}"; value="${value%\'}"; value="${value#\'}"
  printf '%s' "$value"
}

DATABASE_URL_VALUE="$(env_get DATABASE_URL)"
if [ -n "$DATABASE_URL_VALUE" ]; then
  # postgresql://user:password@host:port/dbname?options
  rest="${DATABASE_URL_VALUE#*://}"
  creds="${rest%%@*}"; hostpart="${rest#*@}"
  DB_USER="${creds%%:*}"; DB_PASSWORD="${creds#*:}"
  hostport="${hostpart%%/*}"; DB_NAME="${hostpart#*/}"; DB_NAME="${DB_NAME%%\?*}"
  DB_HOST="${hostport%%:*}"; DB_PORT="${hostport##*:}"; [ "$DB_PORT" = "$hostport" ] && DB_PORT="5432"
  # percent-decoding for user/password/name
  urldecode() { local s="${1//+/ }"; printf '%b' "${s//%/\\x}"; }
  DB_USER="$(urldecode "$DB_USER")"; DB_PASSWORD="$(urldecode "$DB_PASSWORD")"; DB_NAME="$(urldecode "$DB_NAME")"
  ok "database from DATABASE_URL"
else
  DB_NAME="$(env_get POSTGRES_DB)";        DB_NAME="${DB_NAME:-united_church_school_db}"
  DB_USER="$(env_get POSTGRES_USER)";      DB_USER="${DB_USER:-postgres}"
  DB_PASSWORD="$(env_get POSTGRES_PASSWORD)"
  DB_HOST="$(env_get POSTGRES_HOST)";      DB_HOST="${DB_HOST:-127.0.0.1}"
  DB_PORT="$(env_get POSTGRES_PORT)";      DB_PORT="${DB_PORT:-5432}"
  ok "database from POSTGRES_* settings"
fi
echo "       name=${DB_NAME}  user=${DB_USER}  host=${DB_HOST}:${DB_PORT}"
[ -n "$DB_PASSWORD" ] || die "POSTGRES_PASSWORD is empty in .env — the platform refuses a passwordless database."

case "$DB_HOST" in
  ""|localhost|127.0.0.1|::1|/*) DB_LOCAL=1 ;;
  *) DB_LOCAL=0 ;;
esac
USE_REDIS="$(env_get USE_REDIS | tr '[:upper:]' '[:lower:]')"
REDIS_URL="$(env_get REDIS_URL)"

# ---------------------------------------------------------------------------
# 2. Python 3.12+
# ---------------------------------------------------------------------------
step "2/9  Python ${PY_MIN_MAJOR}.${PY_MIN_MINOR}+"
py_ok() { "$1" -c "import sys; sys.exit(0 if sys.version_info >= (${PY_MIN_MAJOR}, ${PY_MIN_MINOR}) else 1)" 2>/dev/null; }
PYTHON=""
for candidate in python3.13 python3.12 python3 \
                 /opt/homebrew/opt/python@3.12/bin/python3.12 /usr/local/opt/python@3.12/bin/python3.12 \
                 /Library/Frameworks/Python.framework/Versions/3.13/bin/python3 \
                 /Library/Frameworks/Python.framework/Versions/3.12/bin/python3; do
  path="$(command -v "$candidate" 2>/dev/null || true)"
  if [ -n "$path" ] && py_ok "$path"; then PYTHON="$path"; break; fi
done
if [ -z "$PYTHON" ] && [ "$CHECK_ONLY" -eq 0 ]; then
  warn "Python ${PY_MIN_MAJOR}.${PY_MIN_MINOR}+ not found."
  if confirm "Install Python 3.12 now?"; then
    if [ "$PLATFORM" = "macos" ]; then
      ensure_brew
      brew install python@3.12 && PYTHON="$(brew --prefix python@3.12)/bin/python3.12"
    else
      $SUDO apt-get update -y && $SUDO apt-get install -y python3.12 python3.12-venv python3.12-dev \
        && PYTHON="$(command -v python3.12)"
    fi
  fi
fi
[ -n "$PYTHON" ] && py_ok "$PYTHON" || die "Python ${PY_MIN_MAJOR}.${PY_MIN_MINOR}+ is required (Django 6)."
ok "$("$PYTHON" --version) at $PYTHON"

# ---------------------------------------------------------------------------
# 3. Virtual environment .environment
# ---------------------------------------------------------------------------
step "3/9  Virtual environment ($ENV_DIR)"
if [ -x "$ENV_DIR/bin/python" ] && ! py_ok "$ENV_DIR/bin/python"; then
  warn "$ENV_DIR uses an old Python — rebuilding it."
  [ "$CHECK_ONLY" -eq 0 ] && rm -rf -- "$ROOT/.environment"
fi
if [ ! -x "$ENV_DIR/bin/python" ]; then
  [ "$CHECK_ONLY" -eq 1 ] && die "$ENV_DIR does not exist — run bash .setup without --check."
  "$PYTHON" -m venv "$ENV_DIR" || die "could not create $ENV_DIR (on Linux: apt install python3.12-venv)."
  ok "created $ENV_DIR"
else
  ok "$ENV_DIR exists"
fi
# shellcheck disable=SC1091
source "$ENV_DIR/bin/activate" || die "could not activate $ENV_DIR"
ok "activated ($(python --version))"

# ---------------------------------------------------------------------------
# 4. requirements.txt
# ---------------------------------------------------------------------------
step "4/9  Python packages (requirements.txt)"
if [ "$CHECK_ONLY" -eq 0 ]; then
  if [ "$PLATFORM" = "linux" ] && ! have pg_config; then
    $SUDO apt-get install -y build-essential libpq-dev >/dev/null 2>&1 || true
  fi
  python -m pip install --upgrade pip wheel setuptools -q || warn "could not upgrade pip"
  if python -m pip install -r requirements.txt; then
    ok "requirements.txt installed"
  else
    warn "bulk install failed — retrying package by package (.install_requirements.py)"
    python .install_requirements.py --yes --no-upgrade-python || fail "some packages did not install — see installation_report.txt"
  fi
fi
if python -c "import django, psycopg2, channels, allauth" 2>/dev/null; then
  ok "core packages import (Django $(python -c 'import django; print(django.get_version())'))"
else
  die "core packages are missing — check the pip output above."
fi

# ---------------------------------------------------------------------------
# 5. PostgreSQL
# ---------------------------------------------------------------------------
step "5/9  PostgreSQL"
PG_BIN=""
PG_FLAVOUR=""      # homebrew | edb | postgresapp | linux | path
find_pg_bin() {
  # The EDB installer (postgresql.org's macOS/Windows download) puts PostgreSQL
  # in /Library/PostgreSQL/<version> and does NOT add it to PATH; Postgres.app
  # lives in /Applications. Prefer the newest of whatever is already here.
  local d
  for d in $(ls -d /Library/PostgreSQL/*/bin 2>/dev/null | sort -t/ -k4 -n -r); do
    [ -x "$d/psql" ] && PG_BIN="$d" && PG_FLAVOUR="edb" && return 0
  done
  for d in /Applications/Postgres.app/Contents/Versions/latest/bin; do
    [ -x "$d/psql" ] && PG_BIN="$d" && PG_FLAVOUR="postgresapp" && return 0
  done
  if [ "$PLATFORM" = "macos" ] && have brew; then
    local prefix
    for formula in "postgresql@${PG_VERSION}" postgresql; do
      prefix="$(brew --prefix "$formula" 2>/dev/null)"
      [ -x "$prefix/bin/psql" ] && PG_BIN="$prefix/bin" && PG_FLAVOUR="homebrew" && return 0
    done
  fi
  for d in $(ls -d /usr/lib/postgresql/*/bin 2>/dev/null | sort -t/ -k5 -n -r); do
    [ -x "$d/psql" ] && PG_BIN="$d" && PG_FLAVOUR="linux" && return 0
  done
  if have psql; then PG_BIN="$(dirname "$(command -v psql)")"; PG_FLAVOUR="path"; return 0; fi
  return 1
}
pg_ready() {
  case "$DB_HOST" in /*) [ -S "$DB_HOST/.s.PGSQL.$DB_PORT" ]; return ;; esac
  if [ -n "$PG_BIN" ] && [ -x "$PG_BIN/pg_isready" ]; then
    "$PG_BIN/pg_isready" -h "$DB_HOST" -p "$DB_PORT" >/dev/null 2>&1
  else
    python -c "import socket,sys; socket.create_connection((sys.argv[1], int(sys.argv[2])), 3)" \
      "$DB_HOST" "$DB_PORT" >/dev/null 2>&1
  fi
}

if [ "$DB_LOCAL" -eq 1 ]; then
  if ! find_pg_bin && [ "$CHECK_ONLY" -eq 0 ]; then
    warn "PostgreSQL is not installed on this computer."
    if confirm "Install PostgreSQL ${PG_VERSION} now?"; then
      if [ "$PLATFORM" = "macos" ]; then
        ensure_brew
        brew install "postgresql@${PG_VERSION}" || die "brew install postgresql@${PG_VERSION} failed"
      else
        $SUDO apt-get update -y && $SUDO apt-get install -y postgresql postgresql-contrib \
          || die "apt-get install postgresql failed"
      fi
      find_pg_bin || die "PostgreSQL installed but psql was not found on PATH."
    fi
  fi
  [ -n "$PG_BIN" ] || die "PostgreSQL is required — install it and re-run."
  ok "PostgreSQL found ($PG_FLAVOUR): $("$PG_BIN/psql" --version) in $PG_BIN"
  if ! pg_ready && [ "$CHECK_ONLY" -eq 0 ]; then
    echo "  starting PostgreSQL …"
    if [ "$PLATFORM" = "macos" ] && [ "$PG_FLAVOUR" = "homebrew" ]; then
      brew services start "postgresql@${PG_VERSION}" >/dev/null 2>&1 || brew services start postgresql >/dev/null 2>&1 || true
    elif [ "$PG_FLAVOUR" = "edb" ]; then
      edb_dir="$(dirname "$PG_BIN")"
      sudo launchctl kickstart -k "system/postgresql-$(basename "$edb_dir")" >/dev/null 2>&1 \
        || sudo -u postgres "$PG_BIN/pg_ctl" -D "$edb_dir/data" start >/dev/null 2>&1 || true
    elif [ "$PG_FLAVOUR" = "postgresapp" ]; then
      open -a Postgres >/dev/null 2>&1 || true
    elif [ "$PLATFORM" = "macos" ]; then
      brew services start "postgresql@${PG_VERSION}" >/dev/null 2>&1 || brew services start postgresql >/dev/null 2>&1 || true
    else
      $SUDO systemctl enable --now postgresql >/dev/null 2>&1 || $SUDO service postgresql start >/dev/null 2>&1 || true
    fi
    for _ in $(seq 1 20); do pg_ready && break; sleep 1; done
  fi
  pg_ready && ok "server is accepting connections on ${DB_HOST}:${DB_PORT}" \
           || die "PostgreSQL is not answering on ${DB_HOST}:${DB_PORT}."
else
  ok "database server is remote (${DB_HOST}) — nothing to install here"
fi

# ---------------------------------------------------------------------------
# 6. Database user + database, exactly as in .env
# ---------------------------------------------------------------------------
step "6/9  Database '${DB_NAME}' and user '${DB_USER}'"
# The SQL that makes the .env user and database exist (idempotent; also syncs
# the user's password to the one in .env).
ENSURE_SQL="$(cat <<'SQL'
SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'dbuser', :'dbpass')
 WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = :'dbuser') \gexec
SELECT format('ALTER ROLE %I WITH LOGIN PASSWORD %L', :'dbuser', :'dbpass') \gexec
SELECT format('CREATE DATABASE %I OWNER %I ENCODING ''UTF8'' TEMPLATE template0', :'dbname', :'dbuser')
 WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = :'dbname') \gexec
SELECT format('GRANT ALL PRIVILEGES ON DATABASE %I TO %I', :'dbname', :'dbuser') \gexec
SQL
)"
# The same, for when the .env user already exists and may create databases.
CREATE_DB_SQL="$(cat <<'SQL'
SELECT format('CREATE DATABASE %I ENCODING ''UTF8'' TEMPLATE template0', :'dbname')
 WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = :'dbname') \gexec
SQL
)"
psql_vars=(-v ON_ERROR_STOP=1 -q -v dbuser="$DB_USER" -v dbpass="$DB_PASSWORD" -v dbname="$DB_NAME")

# Run SQL as the PostgreSQL administrator on this machine:
#   Homebrew / Postgres.app — your own macOS account (no password);
#   EDB installer (/Library/PostgreSQL) — the 'postgres' user and the password
#     chosen when PostgreSQL was installed (POSTGRES_ADMIN_PASSWORD, or asked);
#   Linux packages — the 'postgres' system user, through sudo.
admin_psql() {
  case "$PG_FLAVOUR" in
    linux)
      $SUDO -u postgres "$PG_BIN/psql" -p "$DB_PORT" -d postgres "$@" ;;
    edb)
      if [ -z "${POSTGRES_ADMIN_PASSWORD:-}" ]; then
        read -r -s -p "  Password for the PostgreSQL administrator 'postgres' (set when PostgreSQL was installed): " POSTGRES_ADMIN_PASSWORD
        echo
      fi
      PGPASSWORD="$POSTGRES_ADMIN_PASSWORD" "$PG_BIN/psql" -h "$DB_HOST" -p "$DB_PORT" -U postgres -d postgres "$@" ;;
    *)
      "$PG_BIN/psql" -h "$DB_HOST" -p "$DB_PORT" -d postgres "$@" ;;
  esac
}
user_psql() {   # as the .env user
  PGPASSWORD="$DB_PASSWORD" "$PG_BIN/psql" -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" "$@"
}
if [ "$DB_LOCAL" -eq 1 ] && [ "$CHECK_ONLY" -eq 0 ]; then
  if user_psql -d "$DB_NAME" -tAc "select 1" >/dev/null 2>&1; then
    ok "database '${DB_NAME}' already exists and the .env user can log in"
  elif user_psql -d postgres "${psql_vars[@]}" <<<"$CREATE_DB_SQL" >/dev/null 2>&1 \
       && user_psql -d "$DB_NAME" -tAc "select 1" >/dev/null 2>&1; then
    ok "created database '${DB_NAME}' as the existing user '${DB_USER}'"
  else
    echo "  The .env user cannot create the database on its own — using the PostgreSQL administrator."
    if admin_psql "${psql_vars[@]}" <<<"$ENSURE_SQL"; then
      ok "user '${DB_USER}' and database '${DB_NAME}' are in place (password synced from .env)"
    else
      fail "could not create the user/database as the PostgreSQL administrator"
    fi
  fi
fi
if PGPASSWORD="$DB_PASSWORD" "${PG_BIN:+$PG_BIN/}psql" -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" \
     -tAc "select 1" >/dev/null 2>&1 || python - <<'PY' >/dev/null 2>&1
import os, django
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'config.settings')
django.setup()
from django.db import connection
connection.ensure_connection()
PY
then
  ok "logged in to '${DB_NAME}' as '${DB_USER}' with the .env password"
else
  die "cannot connect to '${DB_NAME}' as '${DB_USER}' — check POSTGRES_* in .env."
fi

# ---------------------------------------------------------------------------
# 7. Redis (only when .env turns it on)
# ---------------------------------------------------------------------------
step "7/9  Redis"
if [ "$USE_REDIS" = "true" ] || [ "$USE_REDIS" = "1" ] || [ "$USE_REDIS" = "yes" ]; then
  REDIS_HOST="$(printf '%s' "$REDIS_URL" | sed -E 's#^rediss?://([^@/]*@)?([^:/]+).*#\2#')"
  REDIS_PORT="$(printf '%s' "$REDIS_URL" | sed -nE 's#^rediss?://([^@/]*@)?[^:/]+:([0-9]+).*#\2#p')"; REDIS_PORT="${REDIS_PORT:-6379}"
  case "$REDIS_HOST" in localhost|127.0.0.1|::1) REDIS_LOCAL=1 ;; *) REDIS_LOCAL=0 ;; esac
  if [ "$REDIS_LOCAL" -eq 1 ] && ! have redis-server && [ "$CHECK_ONLY" -eq 0 ] && confirm "Install Redis now?"; then
    if [ "$PLATFORM" = "macos" ]; then brew install redis && brew services start redis
    else $SUDO apt-get install -y redis-server && $SUDO systemctl enable --now redis-server; fi
  fi
  if python - "$REDIS_URL" <<'PY' >/dev/null 2>&1
import sys, redis
redis.Redis.from_url(sys.argv[1], socket_connect_timeout=3).ping()
PY
  then ok "Redis answers at ${REDIS_HOST}:${REDIS_PORT}"
  else warn "USE_REDIS=true but Redis at ${REDIS_HOST}:${REDIS_PORT} does not answer — live chat/notification push and the cache will hang or fail. Start Redis there, or set USE_REDIS=false in .env for a single-computer setup."
  fi
else
  ok "USE_REDIS is off — the cache and channels run in memory"
fi

# ---------------------------------------------------------------------------
# 8. Django: checks, migrations, school data, static files, accounts
# ---------------------------------------------------------------------------
step "8/9  Application"
python manage.py check >/dev/null 2>&1 && ok "Django system check passed" || { fail "Django system check failed:"; python manage.py check; }

if [ "$CHECK_ONLY" -eq 0 ]; then
  if [ "$RESET" -eq 1 ]; then
    echo "  ${Y}--reset: this DROPS EVERY TABLE in '${DB_NAME}' and rebuilds it.${N}"
    if confirm "Wipe and rebuild '${DB_NAME}' now?"; then
      python .admin_wipe_and_create.py --yes || fail ".admin_wipe_and_create.py failed"
    fi
  else
    python manage.py migrate --noinput && ok "migrations applied" || fail "migrations failed"
    python manage.py migrate captcha --noinput >/dev/null 2>&1 || true
    python manage.py seed_school_structure && ok "school structure: Grade 1 – 12, subjects, fees, calendar" \
      || fail "seed_school_structure failed"
    python manage.py seed_shop --quiet && ok "school shop: uniform and additional fees" || fail "seed_shop failed"
    python manage.py import_seed_packs >/dev/null 2>&1 && ok "bundled content packs imported" || warn "content packs not imported"
    python manage.py seed_lessons >/dev/null 2>&1 && ok "demo lessons: 3 days per subject in every grade (Term 1 Week 1)" \
      || warn "demo lessons not seeded (python manage.py seed_lessons)"
    HAS_USERS="$(python - <<'PY' 2>/dev/null
import os, django
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'config.settings')
django.setup()
from django.contrib.auth import get_user_model
print(get_user_model().objects.exists())
PY
)"
    if [ "$HAS_USERS" != "True" ]; then
      echo "  The database has no accounts yet."
      if confirm "Create the five base accounts (admin, staff, educator, student, parent — password Password@99)? This rebuilds the empty database."; then
        python .admin_wipe_and_create.py --yes >/dev/null && ok "base accounts created (admin@ucs.org.za …)" || fail "account creation failed"
      else
        echo "  You can create an administrator later with:  python manage.py createsuperuser"
      fi
    fi
  fi
  if [ "$DEMO" -eq 1 ]; then
    python .demo_seed.py && ok "demo data loaded" || fail ".demo_seed.py failed"
  fi
  python manage.py collectstatic --noinput >/dev/null 2>&1 && ok "static files collected" || warn "collectstatic failed"
  mkdir -p media/scorm media/h5p backups/archived_accounts && ok "runtime folders ready"
fi

# ---------------------------------------------------------------------------
# 9. Verify
# ---------------------------------------------------------------------------
step "9/9  Verification"
python - <<'PY'
import os, sys
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'config.settings')
G, R, N = ('\033[32m', '\033[31m', '\033[0m') if sys.stdout.isatty() else ('', '', '')
failures = 0

def report(label, good, detail=''):
    global failures
    failures += 0 if good else 1
    print(f"  {G + '[ ok ]' + N if good else R + '[FAIL]' + N} {label}{' — ' + detail if detail else ''}")

import django
django.setup()
from io import StringIO
from django.core.management import call_command
from django.db import connection
from django.test import Client
from django.test.utils import setup_test_environment

try:
    with connection.cursor() as cur:
        cur.execute('select current_database(), current_user, version()')
        db, user, version = cur.fetchone()
    report('database connection', True, f'{db} as {user} ({version.split(",")[0]})')
except Exception as exc:
    report('database connection', False, str(exc)); sys.exit(1)

out = StringIO()
call_command('showmigrations', '--plan', stdout=out)
pending = sum(1 for line in out.getvalue().splitlines() if line.startswith('[ ]'))
report('migrations', pending == 0, 'all applied' if not pending else f'{pending} not applied')

from apps.learning.models import Institution, Programme, ProgrammeModule
from apps.shop.models import Product
school = Institution.objects.filter(code='UCS').first()
report('school', school is not None, school.name if school else 'missing — run: python manage.py seed_school_structure')
grades = Programme.objects.filter(institution=school).count() if school else 0
report('grades', grades == 12, f'{grades} grade(s), {ProgrammeModule.objects.count()} subject offerings')
report('school shop', Product.objects.filter(sku__startswith='UCS-').exists(),
       f'{Product.objects.filter(status="active").count()} active product(s)')

from apps.learning.models import Cohort, Lesson
from apps.learning.models import AcademicCalendar
years = sorted(AcademicCalendar.objects.values_list('year', flat=True).distinct())
report('school calendars', bool(years), ', '.join(map(str, years)) or 'missing — run: python manage.py seed_school_structure')
report('demo lessons', True, f'{Lesson.objects.count()} lesson(s)' + ('' if Lesson.objects.exists() else ' — optional: python manage.py seed_lessons'))
classes = Cohort.objects.filter(programme__institution=school).count() if school else 0
with_teacher = Cohort.objects.filter(programme__institution=school, class_teacher__isnull=False).count() if school else 0
report('classes', classes > 0, f'{classes} class(es), {with_teacher} with a class teacher'
       + ('' if with_teacher == classes else ' — set them on /staff/class-teachers/'))

from django.conf import settings as _s
report('time zone', _s.TIME_ZONE == 'Africa/Johannesburg', _s.TIME_ZONE)
emis = getattr(_s, 'SCHOOL_EMIS_NUMBER', '')
print(f"  {'[ ok ]' if emis else '[note]'} SA-SAMS EMIS number — "
      + (emis if emis else 'not set; add SCHOOL_EMIS_NUMBER= to .env before exporting to the Department'))

from django.contrib.auth import get_user_model
users = get_user_model().objects.count()
report('accounts', True, f'{users} account(s)' + ('' if users else ' — create one: python manage.py createsuperuser'))

from django.conf import settings
setup_test_environment()
client = Client(SERVER_NAME=(settings.ALLOWED_HOSTS[0] if settings.ALLOWED_HOSTS and settings.ALLOWED_HOSTS[0] != '*' else 'localhost'))
try:
    response = client.get('/social/landing/')
    report('landing page', response.status_code < 400, f'HTTP {response.status_code}')
except Exception as exc:
    report('landing page', False, str(exc))
sys.exit(1 if failures else 0)
PY
[ $? -eq 0 ] || FAILURES=$((FAILURES + 1))

echo
if [ "$FAILURES" -eq 0 ]; then
  echo "${G}${B}Setup complete — everything is installed, connected and working.${N}"
else
  echo "${R}${B}Setup finished with ${FAILURES} problem(s) — see the [FAIL] lines above.${N}"
fi
[ "$WARNINGS" -gt 0 ] && echo "${Y}${WARNINGS} warning(s) — see the [warn] lines above.${N}"
cat <<EOF

Next:
  source ${ENV_DIR}/bin/activate
  python .demo_seed.py          # (optional) demo learners, teachers, parents and finances
  python run.py                 # the full stack (preflight, then serve on :8000)
  python manage.py runserver    # or the Django development server
  python run_server.py          # or serve to the whole network

  Landing page : http://127.0.0.1:8000/social/landing/
  Sign in      : admin@ucs.org.za · staff@ucs.org.za · educator@ucs.org.za ·
                 student@ucs.org.za · parent@ucs.org.za  (password Password@99)
  Admin        : http://127.0.0.1:8000/admin/
EOF
exit $([ "$FAILURES" -eq 0 ] && echo 0 || echo 1)
