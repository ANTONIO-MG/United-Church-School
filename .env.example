# =============================================================================
# United Church School learning platform — environment template
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is git-ignored and must NEVER be committed. This file is the only one
# that belongs in version control, and it must never contain a real secret.
#
# Deploying for a new organisation? This file plus `.strings.json` (branding:
# name, logo, colours, contact details) is all you should need to change.
#
# Every variable below is read by config/settings.py unless noted otherwise.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE  — always set these before any non-local deployment
# -----------------------------------------------------------------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Also signs every JWT (SIMPLE_JWT SIGNING_KEY), so a short value weakens API
# auth as well as sessions. Use the full 50 characters.
SECRET_KEY=

# NEVER True in production: it leaks source, settings and stack traces.
DEBUG=False

# Comma-separated. Do not use "*" in production.
ALLOWED_HOSTS=example.com,www.example.com

# Absolute, public base URL. Used to build the links inside e-mails — get this
# wrong and every verification / password-reset link points somewhere useless.
SITE_URL=https://example.com

# Comma-separated, scheme required. Needed for HTTPS form posts.
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL — primary)
#
# Precedence: DATABASE_PUBLIC_URL / DATABASE_URL (a connection URL) wins over
# the discrete POSTGRES_* vars below, which are then ignored entirely.
#
#   * Deployed (Render, Railway, Heroku, Fly) -> DATABASE_URL, which the
#     platform injects into the service itself. Nothing to set here.
#   * From your laptop against that same hosted database -> DATABASE_PUBLIC_URL.
#     The injected DATABASE_URL is a PRIVATE address (Render's internal
#     hostname, Railway's *.railway.internal) that does not resolve anywhere
#     else, so paste the provider's public/external URL here instead — it is
#     preferred whenever the code is not running on the platform.
#       Render:  database dashboard page -> External Database URL
#       Railway: Postgres service -> Variables -> DATABASE_PUBLIC_URL
#   * Neither set -> the POSTGRES_* values below (plain local Postgres)
# -----------------------------------------------------------------------------
DATABASE_URL=
DATABASE_PUBLIC_URL=

POSTGRES_DB=united_church_school_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Connection handling (applies to both styles).
# sslmode defaults to "require" for any remote host and is left off for
# localhost / *.railway.internal. Set it explicitly to override (disable,
# require, verify-ca, verify-full).
POSTGRES_SSLMODE=
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONN_HEALTH_CHECKS=true

# -----------------------------------------------------------------------------
# E-MAIL / SMTP
#
# ⚠️ Port 587 requires EMAIL_USE_TLS=true (STARTTLS). Port 465 requires
#    EMAIL_USE_SSL=true instead. Never set both to true.
#    With neither set, Gmail refuses to authenticate and every e-mail fails
#    *silently* — sign-up verification and password resets simply never arrive.
#
# ⚠️ DEFAULT_FROM_EMAIL must be an address the SMTP account is allowed to send
#    as. Gmail silently rewrites the From: header to the authenticated account
#    unless the alias is verified under Gmail → Settings → Accounts →
#    "Send mail as".
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
# Gmail: an App Password (Google Account → Security → 2-Step Verification →
# App passwords), NOT the account password. Spaces are stripped automatically.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=no-reply@example.com
SERVER_EMAIL=no-reply@example.com

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# mandatory (recommended) | optional | none
# "mandatory" = an account cannot be used until the e-mailed link is clicked.
# Only ever set this to "optional" if you have verified SMTP works — otherwise
# it hides broken e-mail by letting unverified accounts log in.
ACCOUNT_EMAIL_VERIFICATION=mandatory
ACCOUNT_EMAIL_SUBJECT_PREFIX=

# Google sign-in — see docs/google-oauth-setup.md for the Cloud Console steps.
# Leave both blank to disable the Google button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=

# Sign-up bot protection is a self-hosted MATH CAPTCHA (django-simple-captcha):
# a "3 + 4 = ?" image the user answers. It needs NO keys and makes no external
# calls — just run `python manage.py migrate` once so the CaptchaStore table
# exists. Tuning lives in config/settings.py (CAPTCHA_* block).

# -----------------------------------------------------------------------------
# SESSIONS / HTTPS
# -----------------------------------------------------------------------------
# true in production (requires HTTPS). Leave false for plain-HTTP local dev, or
# the session cookie is set but never sent back and you cannot stay logged in.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
DEV_HTTPS=false
# Extra ports to trust for LAN testing, comma-separated (e.g. 8000,8080).
LAN_PORTS=

# The settings below all DEFAULT to the secure value whenever DEBUG=False, so a
# production build is correct without setting any of them. They exist as
# overrides only. apps.diagnostics.deploy_checks refuses to start a DEBUG=False
# build with any of them turned back off — if you need to override one, expect
# `manage.py check` to tell you why you should not.
#
# CSRF_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true

# Set true ONLY when a TLS-terminating proxy (nginx, Azure App Service, a load
# balancer) sits in front and sets X-Forwarded-Proto. Without a proxy that
# always overwrites the header, a client can claim its request arrived over
# HTTPS. Leaving this false behind a proxy causes an infinite redirect loop.
USE_X_FORWARDED_PROTO=false

# Origins the CSRF check accepts a cross-origin POST from. Scheme required.
# Needed once the site is served behind a proxy or on a second domain.
CSRF_TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Wide-open CORS lets any website call /api/ in a signed-in user's browser.
# Defaults to on under DEBUG (so a mobile/desktop client can point at a laptop)
# and off otherwise; deploy.E006 refuses a production boot with it on.
CORS_ALLOW_ALL_ORIGINS=false
# Comma-separated, scheme required, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# -----------------------------------------------------------------------------
# CACHE (optional)
# -----------------------------------------------------------------------------
# Redis is an optional cache. With USE_REDIS=true the app tolerates the server
# being down (cache misses are logged, not raised) — but leave it false unless
# you actually run one.
USE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379/1

# --- WebSockets / real-time (Django Channels) — see docs/WEBSOCKETS.md ---
# When on, browsers open a socket for instant chat + notification/message sounds;
# when off (or if no ASGI server is running) everything falls back to REST polling.
WEBSOCKETS_ENABLED=true
# The channel layer (how a Django view reaches a socket). With USE_REDIS=true it
# uses Redis so every worker shares one bus — REQUIRED once you run more than one
# process (e.g. gunicorn/daphne with workers). With USE_REDIS=false a single-proc
# dev server uses an in-memory layer and this URL is ignored. Uses its own db (2)
# so channel traffic never collides with the cache (db 1).
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/2

# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
# local | s3 | azure
FILE_SERVER_BACKEND=local
FILES_ROOT=
FILES_URL=
FILES_PREFIX=

# --- s3 only ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_ACL=

# --- azure only ---
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=
AZURE_URL_EXPIRATION_SECS=

# -----------------------------------------------------------------------------
# LEARNING HUB (SCORM / H5P / LTI)
# -----------------------------------------------------------------------------
SCORM_ROOT=
SCORM_AGAIN_URL=
SCORM_CONTENT_ORIGIN=
H5P_ROOT=
H5P_STANDALONE_URL=
LTI_PLATFORM_ISSUER=

# -----------------------------------------------------------------------------
# PAYMENTS (PayFast)
# -----------------------------------------------------------------------------
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# -----------------------------------------------------------------------------
# ENROLLMENT
# -----------------------------------------------------------------------------
# auto   = enrol the student into the paid course + its subjects/chat groups the
#          moment payment settles, and grant access automatically.
# manual = record payment; an admin reviews and enrols the student.
ENROLLMENT_MODE=manual

# -----------------------------------------------------------------------------
# MEETINGS
# -----------------------------------------------------------------------------
# teams | jitsi
MEETING_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si

# --- Microsoft Teams only ---
MS_TEAMS_ENABLED=false
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_DEFAULT_ORGANIZER=
MS_GRAPH_AUTHORITY=
MS_GRAPH_BASE=

# -----------------------------------------------------------------------------
# LIVE SESSIONS — recordings, YouTube, thumbnails
# -----------------------------------------------------------------------------
# Behaviour (auto-record, OneDrive folder root, reminder leads, YouTube on/off,
# AI follow-up) is NOT set here — it lives in Live session settings in the admin,
# so it can be changed without a deploy. Only credentials belong in this file.
#
# YouTube: optional. Leave blank and recordings play from their OneDrive share
# link instead. To switch it on you need a Google Cloud project with the YouTube
# Data API v3 enabled, an OAuth client for the channel, and a refresh token for
# the youtube.upload scope. Mind the quota — an upload costs 1,600 of a default
# 10,000 units/day, i.e. about six sessions a day before the rest queue.
YOUTUBE_CLIENT_ID=429267518924-3ls4kstc283lqtklmv887v0ltu2u06rt.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=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
YOUTUBE_REFRESH_TOKEN=
# To SCAN your channel and link existing playlists / past-session videos to
# modules & cohorts: set your channel id, and either widen the refresh token above
# to include the youtube.readonly scope (reads unlisted too) or set a public API key.
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=

# Optional TrueType font for the generated session thumbnails. Blank = the
# renderer finds a system face, or falls back to Pillow's built-in.
SESSION_THUMBNAIL_FONT=

# -----------------------------------------------------------------------------
# AI ASSISTANTS (optional)
# -----------------------------------------------------------------------------
AI_ASSISTANT_ENABLED=false
AI_LLM_MODEL=
AI_LLM_API_BASE=
AI_LLM_API_KEY=
WHISPER_MODEL=
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=

ADMIN_AI_ENABLED=false
ANTHROPIC_API_KEY=
ADMIN_AI_MODEL=claude-sonnet-5

# --- WhatsApp (second delivery channel) ------------------------------------
# The platform's second way out: notification copies (the bell, per user opt-in
# under Settings > Notifications) and the registration invoice PDF. Both go
# through core/whatsapp.py, so this is the only place it is configured.
#
# OFF by default. With WHATSAPP_ENABLED unset nothing is sent, nothing fails,
# and e-mail carries on as before — an unconfigured integration must never
# break a notification or a registration.
#
# Credentials: Meta Business account > WhatsApp > API setup. Use a permanent
# system-user token, not the 24-hour test token.
WHATSAPP_ENABLED=False
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ⚠️ Meta only allows free-form messages to someone who messaged you in the last
#    24 hours. Outside that window a business MUST use an approved template, so
#    for production create one (a single {{1}} body parameter) and name it here;
#    the sender then uses it automatically. Leave blank and notifications will be
#    rejected by Meta for anyone who has not recently replied — logged, never raised.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# --- WhatsApp bot (inbound) -------------------------------------------------
# Point Meta's webhook at  https://<your-host>/communication/whatsapp/webhook/
# VERIFY_TOKEN is any string you invent and also type into Meta's webhook setup;
# it is only used for the one-time subscription handshake.
# APP_SECRET is the Meta *app secret* and is what proves an inbound POST really
# came from Meta. ⚠️ With APP_SECRET unset the webhook refuses every request —
# that is on purpose: an unsigned webhook is a stranger's remote control over
# student data. Set it before subscribing.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Dialling code assumed when a stored number has no country code (082… → +2782…).
DEFAULT_DIAL_CODE=27
